{
	"compilerOptions": {
		"module": "commonjs",
    "target": "es2020",
    "moduleResolution": "node",
    "sourceMap": true,
    "resolveJsonModule": true,
		// "lib": [
		// 	"es6"
		// ],
    "declaration": true,
    "downlevelIteration": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "importHelpers": false,
    "removeComments": true,
    "strictPropertyInitialization": false,
    "allowUnreachableCode": false,
    "isolatedModules": false,
		"allowJs": true,
		"strict": true,
		"noImplicitAny": true,
		"forceConsistentCasingInFileNames": true,
		// "moduleResolution": "node",
		"rootDirs": ["apps/api/src", "apps/bot/src", "apps/web/src", "interfaces"],
		"outDir": "./dist",
		"baseUrl": "./",
		"paths": {
			"~/*": ["./*"],
			"@interfaces/*": ["interfaces/*"],
			"@helpers/*": ["helpers/*"],
			"@api/*": ["apps/api/src/*"],
			"@bot/*": ["apps/bot/src/*"],
			"@web/*": ["apps/web/src/*"]
		},
		"emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "incremental": true,
    // "skipLibCheck": true
	},
	"include": [
		"./interfaces/**/*.ts",
		"./apps/api/src/**/*.ts",
		"./apps/bot/src/**/*.ts",
    // "./api/src/**/*.tsx",
    // "./api/src/**/*.vue",
    // "**/*.ts",
    // "**/*.tsx",
    // "**/*.vue",
  ],
	"exclude": [
		"node_modules",
	]
}