{
	"name": "node-api-starter",
	"version": "1.0.0",
	"description": "Node.js Restful API starter project",
	"main": "index.js",
	"scripts": {
		"start": "pnpm build && node dist/index.js",
		"start:dev": "nodemon",
		"build": "rimraf ./build && tsc --traceResolution"
	},
	"keywords": [
		"node",
		"typescript",
		"mongo",
		"mongoose",
		"fastify",
		"swagger",
		"jest"
	],
	"author": "Georgi Marokov <georgi.marokov@gmail.com> (www.worldwildweb.dev)",
	"license": "ISC",
	"repository": {
		"type": "git",
		"url": "git://github.com/gmarokov/node-fastify-mongo-api.git"
	},
	"_moduleAliases": {
    "@api": "dist"
  },
	"dependencies": {
		"@hapi/boom": "^10.0.0",
		"dotenv": "^16.0.1",
		"fastify": "^3.29.0",
		"@fastify/swagger": "^6.0.1",
		"mongodb-memory-server": "^8.6.0",
		"@typegoose/typegoose": "^9.8.1",
		"agenda": "^4.3.0",
		"date-fns": "^2.28.0",
		"module-alias": "^2.2.2",
		"node-fetch": "^3.2.4",
		"mongoose": "^6.3.4"
	},
	"devDependencies": {
		"@types/boom": "^7.3.2",
		"@types/node": "^17.0.35",
		"cross-env": "^7.0.3",
		"nodemon": "^2.0.16",
		"rimraf": "^3.0.2",
		"ts-node": "^10.8.0",
		"typescript": "^4.6.4"
	}
}