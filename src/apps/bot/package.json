{
  "name": "telegraf-template",
  "version": "1.0.0",
  "description": "Telegraf.js bot starter template",
  "author": "deptyped <deptyped@gmail.com>",
  "homepage": "https://github.com/RookMeister/telegram-bot-starter#readme",
  "bugs": {
    "url": "https://github.com/RookMeister/telegram-bot-starter/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RookMeister/telegram-bot-starter.git"
  },
  "keywords": [
    "telegram",
    "telegraf.js",
    "telegraf",
    "bot",
    "telegram-bot",
    "template",
    "starter"
  ],
  "license": "MIT",
  "private": true,
  "main": "dist/app.js",
  "scripts": {
    "start": "node dist/app.js",
    "start:dev": "pnpm build && concurrently -i -k -n \"bot,build\" -c \"blue.bold,yellow.bold\" \"pnpm watch:js\" \"pnpm watch:ts --preserveWatchOutput\"",
    "build": "tsc --skipLibCheck",
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "watch:ts": "tsc -w",
    "watch:js": "nodemon dist/app.js --watch dist --watch .env"
  },
  "dependencies": {
    "debug": "^4.3.4",
    "@typegoose/typegoose": "^9.8.1",
    "agenda": "^4.3.0",
    "date-fns": "^2.28.0",
    "dotenv": "^16.0.1",
    "fastify": "^3.29.0",
    "fastify-telegraf": "^1.0.2",
    "module-alias": "^2.2.2",
    "mongoose": "6.3.4",
    "node-fetch": "^3.2.4",
    "pino": "^7.11.0",
    "pino-pretty": "^7.6.1",
    "playwright-chromium": "^1.22.2",
    "table": "^6.8.0",
    "telegraf": "^4.8.2",
    "telegraf-callback-data": "^0.2.6",
    "telegraf-session-local": "^2.1.0",
    "telegraf-update-logger": "^1.5.0",
    "typescript": "^4.6.4",
    "zod": "^3.17.2"
  },
  "devDependencies": {
    "@types/node": "^17.0.35",
    "concurrently": "^7.2.1",
    "nodemon": "^2.0.16",
    "prettier": "^2.6.2",
    "rimraf": "^3.0.2"
  },
  "_moduleAliases": {
    "@bot": "dist"
  },
  "nodemonConfig": {
    "delay": 50
  }
}
